# ---------------------------------------------------------------------------
# DEVELOPMENT SEEDING ONLY — not read by the running app.
#
# The LMSTUDIO_* and MCP_SERVER_URL values below are consumed ONLY by the dev
# seed script (`npm run seed:dev-config`, backend/src/dev/seedDevConfig.ts),
# which writes a starter mcpscope.config.json. To use them, copy this file to
# `.env.dev` and fill in real values.
#
# Runtime configuration (LM connections, model configs, MCP profiles) is done
# through the Web UI and persisted to mcpscope.config.json — NOT via these env
# vars. The only environment variables the running backend reads are the
# BACKEND_*/MCPSCOPE_*/APP_VERSION settings read by the backend (backend/src/config.ts; MCPSCOPE_CONFIG_PATH in backend/src/app.ts):
#   BACKEND_HOST, BACKEND_PORT, BACKEND_DATA_DIR, BACKEND_SQLITE_PATH,
#   BACKEND_CORS_ORIGIN, BACKEND_STATIC_DIR, BACKEND_MAX_TOOL_ROUNDS,
#   MCPSCOPE_CONFIG_PATH, APP_VERSION.
# ---------------------------------------------------------------------------

# Dev seed script inputs (see above):
LMSTUDIO_BASE_URL=https://your-lmstudio-host/v1
LMSTUDIO_API_KEY=replace-me
LMSTUDIO_MODEL=replace-me
MCP_SERVER_URL=http://localhost:3001/mcp

# Runtime backend setting (read by backend/src/config.ts):
BACKEND_MAX_TOOL_ROUNDS=20
