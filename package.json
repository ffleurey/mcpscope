{
  "name": "mcpscope",
  "private": true,
  "version": "0.15.0",
  "description": "Inspect, test, and benchmark MCP servers with local and remote LLMs.",
  "author": "Franck Fleurey",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "electron/dist/main.js",
  "bin": {
    "mcpscope": "./cli/dist/index.js"
  },
  "files": [
    "cli/dist",
    "backend/dist",
    "frontend/dist"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:cli": "tsx cli/src/index.ts",
    "seed:dev-config": "tsx backend/src/dev/seedDevConfig.ts",
    "seed:dev-sessions": "tsx backend/src/dev/seedCapturedSessions.ts",
    "seed:dev-data": "npm run seed:dev-config && npm run seed:dev-sessions",
    "build": "vite build --config frontend/vite.config.ts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:cli": "tsc -p cli/tsconfig.json",
    "build:all": "npm run build && npm run build:backend && npm run build:cli",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start:electron": "electron .",
    "dist:electron": "npm run build:all && npm run build:electron && electron-builder",
    "dist:electron:dir": "npm run build:all && npm run build:electron && electron-builder --dir",
    "prepublishOnly": "npm run build:all",
    "start:backend": "node backend/dist/server.js",
    "preview": "vite preview --config frontend/vite.config.ts",
    "check": "svelte-check --tsconfig ./frontend/tsconfig.json && tsc -p frontend/tsconfig.node.json",
    "check:backend": "tsc -p backend/tsconfig.json --noEmit",
    "check:cli": "tsc -p cli/tsconfig.json --noEmit",
    "check:electron": "tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint frontend/src",
    "lint:backend": "eslint backend/src --ext .ts",
    "lint:cli": "eslint cli/src",
    "lint:fix": "eslint frontend/src --fix",
    "format": "prettier --write \"frontend/src/**/*.{ts,svelte,css}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,svelte,css}\"",
    "verify": "npm run format:check && npm run lint && npm run lint:backend && npm run lint:cli && npm run check && npm run check:backend && npm run check:cli && npm test",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "fastify": "^5.6.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@mdi/js": "^7.4.47",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/markdown-it": "^14.1.2",
    "fastify": "^5.6.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "zod": "^4.4.3"
  }
}
