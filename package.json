{
  "name": "ai-clientapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch backend/src/server.ts",
    "build": "vite build",
    "build:backend": "tsc -p backend/tsconfig.json",
    "start:backend": "node backend/dist/server.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:backend": "tsc -p backend/tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:backend": "eslint backend/src --ext .ts",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@fastify/cors": "^11.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.2",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "fastify": "^5.6.1",
    "globals": "^17.6.0",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "typescript": "~6.0.2",
    "tsx": "^4.20.6",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.4.1",
    "idb": "^8.0.3",
    "zod": "^4.4.3"
  }
}
