{
  "name": "mcpscope",
  "version": "0.1.7",
  "description": "A local-first workbench for developing, inspecting, and benchmarking MCP servers against local (LM Studio, Ollama) or remote (OpenRouter) models — Web UI, CLI, and MCP interface over one shared store.",
  "license": "Apache-2.0",
  "author": "Franck Fleurey <756491+ffleurey@users.noreply.github.com>",
  "homepage": "https://github.com/ffleurey/mcpscope#readme",
  "bugs": {
    "url": "https://github.com/ffleurey/mcpscope/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffleurey/mcpscope.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "mcp-server",
    "llm",
    "llm-evaluation",
    "llm-eval",
    "benchmark",
    "evaluation",
    "observability",
    "ai-agents",
    "agent",
    "tool-calling",
    "tool-use",
    "local-first",
    "local-llm",
    "lm-studio",
    "ollama",
    "openrouter",
    "cli",
    "typescript"
  ],
  "desktopName": "mcpscope.desktop",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "electron/dist/main.js",
  "bin": {
    "mcpscope": "./cli/dist/index.js"
  },
  "files": [
    "cli/dist",
    "backend/dist",
    "frontend/dist",
    "NOTICE"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:backend": "npm run build:engine && tsx watch backend/src/server.ts",
    "dev:cli": "tsx cli/src/index.ts",
    "seed:dev-config": "npm run build:engine && tsx backend/src/dev/seedDevConfig.ts",
    "seed:dev-sessions": "npm run build:engine && tsx backend/src/dev/seedCapturedSessions.ts",
    "seed:dev-data": "npm run seed:dev-config && npm run seed:dev-sessions",
    "build": "vite build --config frontend/vite.config.ts",
    "build:engine": "npm run build --workspace mcpscope-engine",
    "build:backend": "npm run build:engine && tsc -p backend/tsconfig.build.json",
    "build:cli": "tsc -p cli/tsconfig.json",
    "build:all": "npm run build && npm run build:backend && npm run build:cli",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start:electron": "electron .",
    "dist:electron": "npm run build:all && npm run build:electron && electron-builder",
    "dist:electron:dir": "npm run build:all && npm run build:electron && electron-builder --dir",
    "prepublishOnly": "npm run build:all",
    "start:backend": "node backend/dist/server.js",
    "preview": "vite preview --config frontend/vite.config.ts",
    "check": "svelte-check --tsconfig ./frontend/tsconfig.json && tsc -p frontend/tsconfig.node.json",
    "check:engine": "tsc -p packages/engine/tsconfig.json --noEmit",
    "check:backend": "tsc -p backend/tsconfig.check.json --noEmit",
    "check:cli": "tsc -p cli/tsconfig.json --noEmit",
    "check:electron": "tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint frontend/src",
    "lint:engine": "eslint packages/engine/src --ext .ts",
    "lint:backend": "eslint backend/src --ext .ts",
    "lint:cli": "eslint cli/src",
    "lint:electron": "eslint electron/src",
    "lint:fix": "eslint frontend/src --fix",
    "format": "prettier --write \"frontend/src/**/*.{ts,svelte,css}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,svelte,css}\"",
    "verify": "npm run format:check && npm run lint && npm run lint:engine && npm run lint:backend && npm run lint:cli && npm run lint:electron && npm run check && npm run check:engine && npm run check:backend && npm run check:cli && npm run check:electron && npm test",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.6.1",
    "mcpscope-engine": "0.1.7",
    "zod": "^4.4.3"
  }
}
